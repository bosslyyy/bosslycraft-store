# Variables públicas: se incluyen en el bundle del navegador.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_IP=bosslycraft.net

# PostgreSQL. Sustituye todos los marcadores; este valor no es una credencial real.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Importes en centavos USD, leídos únicamente por el servidor.
MONTHLY_GOAL_CENTS=2000
DEMO_RAISED_CENTS=750

# Reservado para la futura integración con el plugin. Déjalo vacío por ahora.
SERVER_API_TOKEN=

# Tebex Headless API. Configura los valores reales solo en .env.local/Vercel.
TEBEX_PUBLIC_TOKEN=
TEBEX_PRIVATE_KEY=
TEBEX_WEBHOOK_SECRET=
TEBEX_PACKAGE_BOSSLY_ID=
TEBEX_PACKAGE_BOSSLY_PLUS_ID=
TEBEX_PACKAGE_BOSSLY_PREMIUM_ID=
